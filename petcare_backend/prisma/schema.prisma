generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  fullName         String
  email            String            @unique
  phone            String?           @unique
  passwordHash     String?
  firebaseUid      String?           @unique
  role             UserRole          @default(OWNER)
  avatarUrl        String?
  isVerified       Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  bookingsAsOwner  Booking[]         @relation("OwnerBookings")
  pets             Pet[]
  reviews          Review[]
  sitter           Sitter?
  violationReports ViolationReport[]
  messages         Message[]
  addresses        Address[]
}

model Address {
  id          String       @id @default(uuid())
  userId      String
  label       AddressLabel @default(HOME)
  customLabel String?
  province    String
  ward        String
  street      String
  note        String?
  lat         Float
  lng         Float
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

model Sitter {
  id                 String          @id @default(uuid())
  userId             String          @unique
  bio                String?
  ratingAvg          Float           @default(0)
  totalReviews       Int             @default(0)
  backgroundChecked  Boolean         @default(false)
  lat                Float?
  lng                Float?
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  // Hồ sơ đăng ký NCC (bước xác minh danh tính)
  status             SitterStatus    @default(PENDING)
  legalName          String?
  gender             Gender?
  dateOfBirth        DateTime?       @db.Date
  nationalId         String?         @unique
  idIssuedPlace      String?
  idIssuedDate       DateTime?       @db.Date
  province           String?
  addressDetail      String?
  cccdFrontPath      String?
  cccdBackPath       String?
  submittedAt        DateTime?       @db.Timestamptz(3)
  serviceAddress     String?
  serviceAddressNote String?
  serviceRadiusKm    Int?
  onboardedAt        DateTime?       @db.Timestamptz(3)
  services           SitterService[]
  bookings           Booking[]       @relation("SitterBookings")
  photos             SitterPhoto[]
  daysOff            SitterDayOff[]
  user               User            @relation(fields: [userId], references: [id])
}

model SitterPhoto {
  id        String   @id @default(uuid())
  sitterId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sitter    Sitter   @relation(fields: [sitterId], references: [id], onDelete: Cascade)

  @@index([sitterId])
}

model SitterDayOff {
  id       String   @id @default(uuid())
  sitterId String
  date     DateTime @db.Date
  sitter   Sitter   @relation(fields: [sitterId], references: [id], onDelete: Cascade)

  @@unique([sitterId, date])
  @@index([sitterId])
}

model SitterService {
  id        String      @id @default(uuid())
  sitterId  String
  type      ServiceType
  enabled   Boolean     @default(false)
  petKind   PetKind     @default(BOTH)
  pricing   Json
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  sitter    Sitter      @relation(fields: [sitterId], references: [id], onDelete: Cascade)

  @@unique([sitterId, type])
  @@index([sitterId])
}

enum PetSpecies {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
}

// Cách thực hiện hạng mục phòng bệnh
enum PreventionForm {
  VACCINE
  ORAL
  SPOT_ON
  OTHER
}

// Đơn vị chu kỳ nhắc lại
enum CycleUnit {
  DAY
  WEEK
  MONTH
}

enum PetKind {
  DOG
  CAT
  BOTH
}

model Pet {
  id             String             @id @default(uuid())
  ownerId        String
  name           String
  species        PetSpecies
  breed          String
  gender         PetGender
  birthDate      DateTime?          @db.Date
  weightKg       Float
  isNeutered     Boolean            @default(false)
  underTreatment Boolean            @default(false)
  chronicDisease String?
  medication     String?
  careNote       String?
  avatarUrl      String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  bookings       BookingPet[]
  photos         PetPhoto[]
  preventions    PreventionRecord[]
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model PetPhoto {
  id        String   @id @default(uuid())
  petId     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

// Một hạng mục phòng bệnh
model PreventionRecord {
  id                  String           @id @default(uuid())
  petId               String
  code                String
  customName          String?
  form                PreventionForm
  isPeriodic          Boolean          @default(false)
  suggestedCycleValue Int?
  suggestedCycleUnit  CycleUnit?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  doses               PreventionDose[]
  pet                 Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model PreventionDose {
  id         String                @id @default(uuid())
  recordId   String
  doneAt     DateTime              @db.Date
  cycleValue Int?
  cycleUnit  CycleUnit?
  place      String?
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  photos     PreventionDosePhoto[]
  record     PreventionRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

// Ảnh phiếu hoặc hoá đơn của một lần thực hiện
model PreventionDosePhoto {
  id        String         @id @default(uuid())
  doseId    String
  url       String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  dose      PreventionDose @relation(fields: [doseId], references: [id], onDelete: Cascade)

  @@index([doseId])
}

model Service {
  id               String      @id @default(uuid())
  type             ServiceType
  name             String
  description      String?
  basePricePerHour Float
  durationMinutes  Int?
  bookings         Booking[]
}

model Booking {
  id                 String            @id @default(uuid())
  ownerId            String
  sitterId           String
  serviceId          String
  status             BookingStatus     @default(PENDING)
  scheduledAt        DateTime          @db.Timestamptz(3)
  startedAt          DateTime?         @db.Timestamptz(3)
  endedAt            DateTime?         @db.Timestamptz(3)
  totalPrice         Float?
  specialNotes       String?
  cancellationFee    Float?
  cancelledBy        String?
  cancellationReason String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  owner              User              @relation("OwnerBookings", fields: [ownerId], references: [id])
  pets               BookingPet[]
  sitter             Sitter            @relation("SitterBookings", fields: [sitterId], references: [id])
  service            Service           @relation(fields: [serviceId], references: [id])
  gpsReport          BookingGpsReport?
  locationTracks     LocationTrack[]
  review             Review?
  sessionPhotos      SessionPhoto[]
  reports            ViolationReport[]
  messages           Message[]
}

model BookingPet {
  bookingId String
  petId     String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pet       Pet     @relation(fields: [petId], references: [id])

  @@id([bookingId, petId])
  @@index([petId])
}

model SessionPhoto {
  id                String     @id @default(uuid())
  bookingId         String
  photoUrl          String
  phase             PhotoPhase
  photoLat          Float?
  photoLng          Float?
  aiRawResponse     Json?
  aiProvider        String?
  aiConfidenceScore Float?
  aiPassed          Boolean?
  aiFailCount       Int?
  ownerOverrideAt   DateTime?  @db.Timestamptz(3)
  ownerOverrideNote String?
  ownerRejectedAt   DateTime?  @db.Timestamptz(3)
  overrideTimeoutAt DateTime?  @db.Timestamptz(3)
  takenAt           DateTime   @default(now()) @db.Timestamptz(3)
  booking           Booking    @relation(fields: [bookingId], references: [id])
}

model LocationTrack {
  id         String   @id @default(uuid())
  bookingId  String
  latitude   Float
  longitude  Float
  clientTs   DateTime @db.Timestamptz(3)
  serverTs   DateTime @db.Timestamptz(3)
  driftMs    Int?
  batchSeq   Int?
  isNoise    Boolean  @default(false)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId, clientTs])
  @@index([bookingId, serverTs])
  @@index([bookingId, isNoise])
}

model BookingGpsReport {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  totalWaypoints   Int
  totalDistanceM   Float
  durationMinutes  Int
  avgSpeedKmh      Float
  suspicionScore   Float    @default(0)
  flaggedForReview Boolean  @default(false)
  suspicionNote    String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  booking          Booking  @relation(fields: [bookingId], references: [id])

  @@index([flaggedForReview])
  @@index([suspicionScore])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewer   User     @relation(fields: [reviewerId], references: [id])
}

model ViolationReport {
  id           String       @id @default(uuid())
  bookingId    String
  reporterId   String
  description  String
  evidenceUrls Json?
  status       ReportStatus @default(OPEN)
  adminNote    String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  booking      Booking      @relation(fields: [bookingId], references: [id])
  reporter     User         @relation(fields: [reporterId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  role      String // OWNER | PROVIDER
  text      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  booking   Booking  @relation(fields: [bookingId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
}

enum UserRole {
  OWNER
  PROVIDER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Trạng thái duyệt hồ sơ NCC
enum SitterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceType {
  WALKING
  BOARDING
  GROOMING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  AWAITING_OWNER_APPROVAL
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  RESOLVED
}

enum PhotoPhase {
  CHECK_IN
  IN_PROGRESS
  CHECK_OUT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
}
